{
  "info": {
    "name": "Restaurante — Parcial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Recursos\" || !pm.collectionVariables.get(\"inicio\")) {",
          "  const inicio = new Date(Date.now() + 7 * 86400000);",
          "  pm.collectionVariables.set(\"inicio\", inicio.toISOString());",
          "  pm.collectionVariables.set(\"fin\", new Date(inicio.getTime() + 7200000).toISOString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Recursos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Cliente\",\n  \"apellidos\": \"Prueba\",\n  \"correo\": \"prueba.parcial@correo.pe\",\n  \"telefono\": \"987654321\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"idCliente\", pm.response.json().idCliente);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear mesa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/mesas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": 99,\n  \"capacidad\": 4,\n  \"activa\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"idMesa\", pm.response.json().idMesa);"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar reserva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/reservas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCliente\": {{idCliente}},\n  \"idMesa\": {{idMesa}},\n  \"fechaInicio\": \"{{inicio}}\",\n  \"fechaFin\": \"{{fin}}\",\n  \"numeroPersonas\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"idReserva\", pm.response.json().idReserva);"
            ]
          }
        }
      ]
    },
