# ---------------------------------------------------------------
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# ---------------------------------------------------------------

# Servidor HTTP: la API se ejecuta en el puerto de la variable PORT
NODE_ENV=development
PORT=3000

# SQL Server (base creada por el repositorio EP-Laboratorio_BBDD)
SQL_SERVER=localhost
SQL_PORT=1433
# Solo si se usa una instancia con nombre (por ejemplo SQLEXPRESS) en lugar del puerto.
# Requiere el servicio "SQL Server Browser" iniciado. Si se usa, SQL_PORT se ignora.
SQL_INSTANCE=
SQL_DATABASE=RestauranteDB
SQL_USER=sa
# Sin "#" (en .env inicia un comentario)
SQL_PASSWORD=REEMPLAZAR_CON_TU_CLAVE
SQL_ENCRYPT=false
SQL_TRUST_CERTIFICATE=true

# MongoDB (base creada por el repositorio EP-Laboratorio_MongoDB)
# Local: mongodb://127.0.0.1:27017   ·   Atlas: mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=RestauranteLogs
